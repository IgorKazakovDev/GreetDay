{
  "mcpServers": {
    "nx": {
      "type": "stdio",
      "command": "pnpm",
      "args": ["nx", "mcp"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT:-}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,labels,projects"
      }
    },
    "penpot": {
      "type": "http",
      "url": "http://localhost:4401/mcp"
    },
    "postgres": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp:0.3.0",
        "--access-mode=restricted"
      ],
      "env": {
        "DATABASE_URI": "${READONLY_DATABASE_URL:-postgresql://greetday_readonly:greetday_readonly_local@localhost:5433/greetday_dev}"
      }
    }
  }
}
