{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(nx *)",
      "Bash(pnpm nx *)",
      "Bash(pnpm exec nx *)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(node tools/scripts/sync-design-tokens.mjs *)",
      "mcp__nx__*"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose stop *)",
      "Bash(nx run db:db:migrate *)",
      "Bash(pnpm nx run db:db:migrate *)",
      "Bash(pnpm nx db:migrate *)",
      "Bash(pnpm nx run db:db:seed *)",
      "Bash(pnpm exec drizzle-kit *)",
      "Bash(npx drizzle-kit *)",
      "Bash(drizzle-kit *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(gh label *)",
      "Bash(gh api *)",
      "Bash(gh project *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(node .claude/skills/backlog-to-issues/backlog-to-issues.mjs * --apply *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(drizzle-kit push *)",
      "Bash(pnpm exec drizzle-kit push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-migrations.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format-file.mjs\""
          }
        ]
      }
    ]
  }
}
