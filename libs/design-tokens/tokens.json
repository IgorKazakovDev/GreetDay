{
  "$description": "PLACEHOLDER. Replace with the Penpot export (W3C DTCG), then run /sync-design-tokens.",
  "color": {
    "$type": "color",
    "background": { "$value": "#FFFFFF" },
    "surface": { "$value": "#F5F5F7" },
    "text": {
      "primary": { "$value": "#1C1C1E" },
      "secondary": { "$value": "#6E6E73" }
    },
    "accent": { "$value": "#FF6B5B" },
    "danger": { "$value": "#D92D20" }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": { "value": 12, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "touchTarget": { "$value": { "value": 44, "unit": "px" } }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "body": { "$value": { "value": 17, "unit": "px" } },
      "title": { "$value": { "value": 28, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    }
  }
}
