{
  "name": "@greetday/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/mobile"
  },
  "nx": {
    "name": "mobile",
    "tags": [
      "scope:mobile",
      "type:app"
    ],
    "targets": {
      "typegen": {
        "command": "expo customize tsconfig.json",
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "CI": "1"
          }
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/src/app/**/*",
          "{projectRoot}/app.json",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/.expo/types",
          "{projectRoot}/expo-env.d.ts"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "typegen"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@greetday/contracts": "workspace:*",
    "@greetday/design-tokens": "workspace:*",
    "@greetday/domain": "workspace:*",
    "expo": "~58.0.22",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "zod": "^4.6.7"
  },
  "main": "index.ts",
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "^58.0.17",
    "jest-expo": "~58.0.13"
  }
}
