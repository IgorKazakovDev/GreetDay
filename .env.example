# Copy to .env (git-ignored) and adjust. Every variable used anywhere in the repo is listed here,
# except the ALLOW_REMOTE_DB safety override, which must never sit in a .env file.
# Nx loads ./.env automatically for tasks; docker compose reads it too.
# Where each variable is set in CI, production and EAS builds, and which ones are secret:
# docs/environments.md

# ── Postgres (docker-compose.yml) ─────────────────────────────────────────────
POSTGRES_USER=greetday
POSTGRES_PASSWORD=greetday_local
POSTGRES_DB=greetday_dev
# 5433 so it does not clash with other local Postgres instances.
POSTGRES_PORT=5433
# Created by docker/postgres/init on first start:
POSTGRES_TEST_DB=greetday_test
POSTGRES_READONLY_USER=greetday_readonly
POSTGRES_READONLY_PASSWORD=greetday_readonly_local

# ── Database URLs ─────────────────────────────────────────────────────────────
# App + migrations (owner role, dev DB).
DATABASE_URL=postgres://greetday:greetday_local@localhost:5433/greetday_dev
# Integration tests (wiped and re-migrated by the test setup). Must point at a local DB.
TEST_DATABASE_URL=postgres://greetday:greetday_local@localhost:5433/greetday_test
# Postgres MCP server (read-only role, dev DB). The postgres-mcp container maps localhost to
# the host automatically. .mcp.json has this value as its default, so you only need to
# export it in your shell if you change the read-only password or port.
READONLY_DATABASE_URL=postgresql://greetday_readonly:greetday_readonly_local@localhost:5433/greetday_dev

# ── API (apps/api) ────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Mobile (apps/mobile) ──────────────────────────────────────────────────────
# EXPO_PUBLIC_* values are bundled into the app: never put secrets here.
# Used by `pnpm nx start mobile` and development builds; preview/production builds take it
# from apps/mobile/eas.json (docs/environments.md).
# On a physical device use your machine's LAN IP instead of localhost.
# Required: the app throws a readable error at startup if it is missing or not an http(s) URL.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Which build this is: development | preview | production. Defaults to development when unset.
# EAS sets it per build profile in apps/mobile/eas.json; locally leave it as development.
EXPO_PUBLIC_APP_ENV=development

# ── MCP servers (.mcp.json) ───────────────────────────────────────────────────
# NOTE: Claude Code expands ${VAR} in .mcp.json from your SHELL environment, not from this file.
# Export GITHUB_PAT in ~/.zshrc (or use `export GITHUB_PAT=$(gh auth token)`) before starting claude.
# GitHub fine-grained PAT, repository access: this repo only.
# Permissions: Issues RW, Pull requests RW, Contents R, Metadata R (Projects RW if you use them).
# https://github.com/settings/personal-access-tokens/new
GITHUB_PAT=
